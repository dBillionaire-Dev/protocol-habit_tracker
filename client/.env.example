# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# --- Database ---
# Project Settings -> Database -> Connection string.
# Used by Drizzle (client/src/lib/db.ts) via the Node/Vercel runtime.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side only — never prefix with NEXT_PUBLIC_. Used for admin
# actions like permanently deleting a user's account. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# --- Paystack (billing) ---
# Server-side only. Settings -> API Keys & Webhooks in your Paystack dashboard.
PAYSTACK_SECRET_KEY="sk_test_xxx"
# One Plan code per tier x billing interval. Create each of these in
# Paystack (Plans -> Create Plan) with NGN pricing/interval set there —
# Paystack is the source of truth for the actual amount charged, not
# this app. See client/src/lib/paystack/plans.ts for the matching
# DISPLAY_PRICING shown on /pricing (keep them in sync).
PAYSTACK_PRO_MONTHLY_PLAN_CODE="PLN_xxx"
PAYSTACK_PRO_ANNUAL_PLAN_CODE="PLN_xxx"
PAYSTACK_PREMIUM_PLUS_MONTHLY_PLAN_CODE="PLN_xxx"
PAYSTACK_PREMIUM_PLUS_ANNUAL_PLAN_CODE="PLN_xxx"

# --- Gemini (Premium Plus AI features) ---
# Server-side only. Get a key at https://aistudio.google.com/apikey
# Not yet consumed by any code — placeholder for the upcoming AI features
# phase (insights, AI support chat).
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Support ---
# Displayed to users on the support/contact screen (upcoming phase).
# Not secrets, but not hardcoded either — fill in real values.
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_SUPPORT_PHONE="+234xxxxxxxxxx"

# Comma-separated. These accounts get full access to every tier and
# can preview any plan from the profile menu, for internal testing.
SUPER_USER_EMAILS="you@example.com"

# Optional. Defaults to gemini-3.5-flash if unset. Override if Google
# deprecates that model.
GEMINI_MODEL="gemini-3.5-flash"

# For technical problems, security concerns, API questions, bug
# reports, developer collaboration.
NEXT_PUBLIC_DEVELOPER_EMAIL="dev@yourdomain.com"
