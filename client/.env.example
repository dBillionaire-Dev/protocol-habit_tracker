# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# --- Database ---
# Project Settings -> Database -> Connection string.
# Used by Drizzle (client/src/lib/db.ts) via the Node/Vercel runtime.
# Use the TRANSACTION pooler (port 6543) here — correct for serverless
# with many short-lived connections.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Used ONLY by `pnpm db:push` / `pnpm db:studio` (see drizzle.config.ts).
# Use the SESSION pooler (port 5432) or the direct connection string —
# NOT the Transaction pooler above. The Transaction pooler doesn't
# support prepared statements, which drizzle-kit's schema introspection
# needs; pointed at port 6543, `db:push` hangs on "Pulling schema from
# database..." and fails with an unhelpful generic error instead of a
# clear one. Falls back to DATABASE_URL if unset.
DIRECT_DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side only — never prefix with NEXT_PUBLIC_. Used for admin
# actions like permanently deleting a user's account. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# --- Paystack (billing) ---
# Server-side only. Settings -> API Keys & Webhooks in your Paystack dashboard.
PAYSTACK_SECRET_KEY="sk_test_xxx"
# One Plan code per tier x billing interval. Create each of these in
# Paystack (Plans -> Create Plan) with NGN pricing/interval set there —
# Paystack is the source of truth for the actual amount charged, not
# this app. See client/src/lib/paystack/plans.ts for the matching
# DISPLAY_PRICING shown on /pricing (keep them in sync).
PAYSTACK_PRO_MONTHLY_PLAN_CODE="PLN_xxx"
PAYSTACK_PRO_ANNUAL_PLAN_CODE="PLN_xxx"
PAYSTACK_PREMIUM_PLUS_MONTHLY_PLAN_CODE="PLN_xxx"
PAYSTACK_PREMIUM_PLUS_ANNUAL_PLAN_CODE="PLN_xxx"

# --- Gemini (Premium Plus AI features) ---
# Server-side only. Get a key at https://aistudio.google.com/apikey
# Not yet consumed by any code — placeholder for the upcoming AI features
# phase (insights, AI support chat).
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Support ---
# Displayed to users on the support/contact screen (upcoming phase).
# Not secrets, but not hardcoded either — fill in real values.
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_SUPPORT_PHONE="+234xxxxxxxxxx"

# Comma-separated. These accounts get full access to every tier and
# can preview any plan from the profile menu, for internal testing.
SUPER_USER_EMAILS="you@example.com"

# Optional. Defaults to gemini-3.5-flash if unset. Override if Google
# deprecates that model.
GEMINI_MODEL="gemini-3.5-flash"

# For technical problems, security concerns, API questions, bug
# reports, developer collaboration.
NEXT_PUBLIC_DEVELOPER_EMAIL="dev@yourdomain.com"

# --- Resend (transactional email) ---
# Server-side only. Get a key at https://resend.com/api-keys
# Used for subscription trial reminder emails (client/src/lib/trial-reminders.ts).
RESEND_API_KEY="re_xxx"
# Must be a verified sender/domain in Resend. Falls back to Resend's
# onboarding@resend.dev sender if unset, which works for testing but is
# rate-limited and not meant for real users.
RESEND_FROM_EMAIL="Protocol <noreply@yourdomain.com>"

# --- Cron (Vercel Cron -> trial reminder sweep) ---
# Generate any long random string. Vercel automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when invoking the cron job defined
# in vercel.json — set the SAME value here and in your Vercel project's
# environment variables. See app/api/cron/trial-reminders/route.ts.
CRON_SECRET="a-long-random-secret"

# --- Web Push (subscription trials & confirmation-window notifications) ---
# Generate with `npx web-push generate-vapid-keys` (run this yourself —
# don't reuse a key you've seen printed anywhere else, generate your own).
# The public key is fine to expose to the client (that's what
# NEXT_PUBLIC_ means here); the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
# Shown to push services as a contact point if they need to reach you
# about your usage (e.g. abuse reports). Any mailto: works.
VAPID_CONTACT_EMAIL="mailto:you@yourdomain.com"

