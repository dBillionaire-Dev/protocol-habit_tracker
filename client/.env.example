# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# --- Database ---
# Project Settings -> Database -> Connection string.
# Used by Drizzle (client/src/lib/db.ts) via the Node/Vercel runtime.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side only — never prefix with NEXT_PUBLIC_. Used for admin
# actions like permanently deleting a user's account. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# --- Paystack (billing) ---
# Server-side only. Settings -> API Keys & Webhooks in your Paystack dashboard.
PAYSTACK_SECRET_KEY="sk_test_xxx"
# The Plan code for the Pro subscription (Paystack dashboard -> Plans -> create one).
PAYSTACK_PRO_PLAN_CODE="PLN_xxx"
