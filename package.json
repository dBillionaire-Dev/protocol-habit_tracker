{
  "name": "protocol-root",
  "private": true,
  "workspaces": {
    "packages": [
      "client"
    ]
  },
  "scripts": {
    "dev": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace client run start",
    "db:push": "dotenv -e client/.env -- drizzle-kit push",
    "db:studio": "dotenv -e client/.env -- drizzle-kit studio"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "zod": "^4.4.3"
  }
}
