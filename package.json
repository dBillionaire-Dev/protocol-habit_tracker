{
  "name": "protocol-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./client dev",
    "build": "pnpm --filter ./client build",
    "start": "pnpm --filter ./client start",
    "db:push": "dotenv -e client/.env -- drizzle-kit push",
    "db:studio": "dotenv -e client/.env -- drizzle-kit studio"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "pg": "8.22.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.34.5"
}
